{
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "process:default",
    "cli:default",
    "os:default",
    "store:default",
    "dialog:default",
    "shell:default",
    "updater:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": ["$DOCUMENT/**"]
    }
  ]
}
